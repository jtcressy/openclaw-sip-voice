{
  "name": "@openclaw/sip-voice",
  "version": "0.0.0",
  "description": "OpenClaw SIP voice plugin foundation",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src"
  ],
  "dependencies": {
    "typebox": "1.1.37"
  },
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/sip-voice",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.3"
    },
    "compat": {
      "pluginApi": ">=2026.5.3"
    },
    "build": {
      "openclawVersion": "2026.5.3"
    }
  }
}
